# ── Server configuration ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/prepview?retryWrites=true&w=majority

# ── Frontend & CORS ──────────────────────────────────────────────────────────
# Set CLIENT_URL and CORS_ORIGIN to your Vercel frontend domain
CLIENT_URL=https://prepview.vercel.app
CORS_ORIGIN=https://prepview.vercel.app

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong random secret: `openssl rand -hex 32`
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# ── AI Providers ──────────────────────────────────────────────────────────────
# Groq (Used for LLM question generation & Whisper STT fallback)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini (Optional backup provider)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
# Get keys from Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_or_live_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_PLAN_ID=plan_your_razorpay_plan_id_here

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Get credentials from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
SERVER_URL=http://localhost:4000
