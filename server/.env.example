# ── Server configuration ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_URI=mongodb+srv://youruser:yourpassword@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong random secret: `openssl rand -hex 32`
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ── AI ────────────────────────────────────────────────────────────────────────
# Choose one provider. The active one is set in gemini.service.ts.

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (fast open-source LLMs: llama-3.1-8b-instant, llama-3.3-70b-versatile, etc.)
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
